/*
 * catmfoo's zed settings
 * :]
 */
{
  "cli_default_open_behavior": "existing_window",
  "diff_view_style": "split",
  "horizontal_scroll_margin": 5.0,
  "vertical_scroll_margin": 10.0,
  "scroll_beyond_last_line": "off",
  "auto_install_extensions": {
    "html": true,
    "php": true,
    "jetbrains-themes": true,
    "angular": true,
  },
  "ensure_final_newline_on_save": false,
  "format_on_save": "on",
  "ui_font_family": "JetBrains Mono NL",
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "buffer_line_height": "comfortable",
  "buffer_font_weight": 400.0,
  "buffer_font_family": "JetBrains Mono NL",
  "vim_mode": true,
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "ui_font_size": 13.0,
  "buffer_font_size": 13.0,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "JetBrains Dark",
  },
  "languages": {
    "TypeScript": { "formatter": "prettier" },
    "HTML": { "formatter": "prettier" },
    "CSS": { "formatter": "prettier" },
    "SCSS": { "formatter": "prettier" },
    "JSON": { "formatter": "prettier" },
    // for angular specifically, the prettier.allowed=true thing is needed
    // for some reason
    "Angular": { "formatter": "prettier", "prettier": { "allowed": true } },
    "PHP": {
      "language_servers": ["intelephense"],
      "formatter": "prettier",
    },
  },
  "lsp": {
    "intelephense": {
      "settings": {
        "files": {
          "exclude": [
            "**/.git/**",
            "**/.svn/**",
            "**/.hg/**",
            "**/CVS/**",
            "**/.DS_Store/**",
            "**/node_modules/**",
            "**/bower_components/**",
            "**/vendor/**/{Tests,tests}/**",
            "**/.history/**",
            "**/vendor/**/vendor/**",
            "**/vendor/fitdegree/**",
          ],
        },
      },
    },
  },
}
