/*
 * catmfoo's zed settings
 * :]
 */
{
  "auto_install_extensions": {
    "html": true,
    "php": true,
    "jetbrains-themes": true,
    "angular": true,
  },
  "ensure_final_newline_on_save": false,
  "format_on_save": "on",
  "ui_font_family": "JetBrains Mono NL",
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "buffer_line_height": "comfortable",
  "buffer_font_weight": 400.0,
  "buffer_font_family": "JetBrains Mono NL",
  "vim_mode": true,
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "ui_font_size": 13.0,
  "buffer_font_size": 13.0,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "JetBrains Dark",
  },
  "languages": {
    "TypeScript": { "formatter": "prettier" },
    "HTML": { "formatter": "prettier" },
    "JSON": { "formatter": "prettier" },
    // for angular specifically, the prettier.allowed=true thing is needed
    // for some reason
    "Angular": { "formatter": "prettier", "prettier": { "allowed": true } },
    "PHP": {
      "language_servers": ["intelephense"],
      "formatter": "prettier",
    },
  },
  "lsp": {
    "intelephense": {
      "settings": {
        "files": {
          "exclude": [
            "**/.git/**",
            "**/.svn/**",
            "**/.hg/**",
            "**/CVS/**",
            "**/.DS_Store/**",
            "**/node_modules/**",
            "**/bower_components/**",
            "**/vendor/**/{Tests,tests}/**",
            "**/.history/**",
            "**/vendor/**/vendor/**",
            "**/vendor/fitdegree/**",
          ],
        },
      },
    },
  },
}
