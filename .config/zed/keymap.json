/*
 * catmfoo's zed keymap
 * :]
 */
[
  // rebind panel toggling to cmd-k as a global leader + a letter. overrides the annoying
  // cmd-shift-<letter> defaults that use toggle focus instead of toggle
  {
    "bindings": {
      "cmd-k e": "project_panel::Toggle",
      "cmd-k o": "outline_panel::Toggle",
      "cmd-k t": "terminal_panel::Toggle",
      "cmd-k g": "git_panel::Toggle",
      "cmd-k a": "agent::Toggle",
      "cmd-k d": "debug_panel::Toggle",
    },
  },
  // add keybind for opening git diff multibuffer
  {
    "bindings": {
      "cmd-shift-d": "git::Diff",
    },
  },
  // add editor keybinds for inline git actions using space as an editor leader
  {
    "context": "Editor && vim_mode != insert",
    "bindings": {
      "space h r": "git::Restore",
    },
  },
  {
    "context": "Editor && vim_mode != insert",
    "bindings": {
      "space h s": "git::ToggleStaged",
    },
  },
  {
    "context": "Editor && vim_mode != insert",
    "bindings": {
      "space h b": "editor::BlameHover",
    },
  },
  {
    "context": "Editor && vim_mode != insert",
    "bindings": {
      "space h p": "editor::ToggleSelectedDiffHunks",
    },
  },
]
